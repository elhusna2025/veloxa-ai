rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isWorkspaceOwnerOrMember(workspaceId) {
      return isSignedIn() && (
        firestore.get(/databases/(default)/documents/workspaces/$(workspaceId)).data.ownerUid == request.auth.uid ||
        request.auth.uid in firestore.get(/databases/(default)/documents/workspaces/$(workspaceId)).data.memberUids
      );
    }

    // Brand Vault Assets (Style References & Real User Photos/Reels)
    match /workspaces/{workspaceId}/vault/{allPaths=**} {
      allow read: if isWorkspaceOwnerOrMember(workspaceId) || isSuperAdmin();
      allow write: if (isWorkspaceOwnerOrMember(workspaceId) || isSuperAdmin())
        && request.resource.size < 100 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }

    // Rendered Content Studio & Autonomous Agent Outputs (PNG slides & MP4 Reels/Shorts)
    match /workspaces/{workspaceId}/renders/{allPaths=**} {
      allow read: if isWorkspaceOwnerOrMember(workspaceId) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
