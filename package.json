{
  "name": "veloxa-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Veloxa AI \u2014 Autonomous Multi-Channel Social Content & Meta Ads Marketing SaaS (Web, Android, iOS)",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "mkdir -p /tmp/veloxa-ai-cache/fontconfig && XDG_CACHE_HOME=/tmp/veloxa-ai-cache NODE_OPTIONS='--no-experimental-webstorage' next dev -p 3035",
    "build": "mkdir -p /tmp/veloxa-ai-cache/fontconfig && XDG_CACHE_HOME=/tmp/veloxa-ai-cache NODE_OPTIONS='--no-experimental-webstorage' NODE_ENV=production next build",
    "build:mobile": "mkdir -p /tmp/veloxa-ai-cache/fontconfig && XDG_CACHE_HOME=/tmp/veloxa-ai-cache NODE_OPTIONS='--no-experimental-webstorage' NODE_ENV=production NEXT_OUTPUT_EXPORT=true next build",
    "start": "mkdir -p /tmp/veloxa-ai-cache/fontconfig && XDG_CACHE_HOME=/tmp/veloxa-ai-cache next start -p ${PORT:-3035}",
    "typecheck": "tsc --noEmit",
    "test": "mkdir -p /tmp/veloxa-ai-cache/fontconfig && XDG_CACHE_HOME=/tmp/veloxa-ai-cache node --import tsx --test src/lib/*.test.ts src/lib/server/*.test.ts",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions test",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "test:browser": "node --import tsx e2e/veloxa-local.spec.ts"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/push-notifications": "^8.0.4",
    "@capacitor/share": "^8.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.16.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.475.0",
    "next": "15.5.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "playwright": "^1.63.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
