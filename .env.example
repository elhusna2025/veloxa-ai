# Copy names into your deployment environment or a local ignored .env.local.
# Never commit actual secrets. Customers do NOT fill these settings.
FIREBASE_PROJECT_ID=veloxa-ai-saas
FIREBASE_STORAGE_BUCKET=veloxa-ai-saas.firebasestorage.app

# Central Meta application owned by Veloxa, with Facebook Login enabled.
META_APP_ID=
META_APP_SECRET=
# Exact HTTPS URL, no trailing slash: https://YOUR_VELOXA_DOMAIN/api/veloxa/meta/callback
META_REDIRECT_URI=
META_GRAPH_API_VERSION=v26.0

# Backend-only random 32-byte key encoded as base64. Bind using a secret store.
# Generate securely outside chat/logs; retain the same key across server restarts.
META_TOKEN_ENCRYPTION_KEY=

# Optional. Without this, captions use a clearly labelled local template.
OPENAI_API_KEY=

# Firebase Admin uses Application Default Credentials. On Firebase App Hosting,
# grant the backend service account the required Firebase/Storage permissions.
# In local/cloud development, use an authorized identity or a secure credential-file binding.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/to/credentials.json
